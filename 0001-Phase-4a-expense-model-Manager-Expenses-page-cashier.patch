diff --git a/lib/features/finance/models/expense.dart b/lib/features/finance/models/expense.dart
new file mode 100644
index 0000000..12dc389
--- /dev/null
+++ b/lib/features/finance/models/expense.dart
@@ -0,0 +1,88 @@
+import 'package:hive/hive.dart';
+
+part 'expense.g.dart';
+
+/// One business expense. Replaces the old workbook-shaped expense that only
+/// ever existed on the unmerged branch and the test tablet (typeId 5).
+///
+/// Amount, date and category are final: a mistake is corrected by voiding
+/// (manager only, reason required) and entering a new expense. Nothing is
+/// ever deleted. Only the three void fields can change after saving.
+@HiveType(typeId: 14)
+class Expense extends HiveObject {
+  @HiveField(0)
+  final String id;
+
+  /// The day the expense was incurred (date only, no time).
+  @HiveField(1)
+  final DateTime date;
+
+  /// When the entry was saved.
+  @HiveField(2)
+  final DateTime createdAt;
+
+  /// Money as a double rounded to 2 places, like everything else in the app.
+  @HiveField(3)
+  final double amount;
+
+  @HiveField(4)
+  final String categoryId;
+
+  /// Copied from the category at save time: direct, operating or non_pnl.
+  @HiveField(5)
+  final String categoryType;
+
+  /// Free text from the manager-editable "paid from" list.
+  @HiveField(6)
+  final String paidFrom;
+
+  @HiveField(7)
+  final String description;
+
+  @HiveField(8)
+  final String? vendor;
+
+  /// Informational only. Does not change [amount].
+  @HiveField(9)
+  final double? inputVat;
+
+  /// Informational only. Does not change [amount].
+  @HiveField(10)
+  final double? whtAmount;
+
+  /// [roleCashier] or [roleManager], decided by where the entry was made.
+  @HiveField(11)
+  final String createdByRole;
+
+  @HiveField(12)
+  DateTime? voidedAt;
+
+  @HiveField(13)
+  String? voidReason;
+
+  @HiveField(14)
+  String? voidedBy;
+
+  Expense({
+    required this.id,
+    required this.date,
+    required this.createdAt,
+    required this.amount,
+    required this.categoryId,
+    required this.categoryType,
+    required this.paidFrom,
+    this.description = '',
+    this.vendor,
+    this.inputVat,
+    this.whtAmount,
+    required this.createdByRole,
+    this.voidedAt,
+    this.voidReason,
+    this.voidedBy,
+  });
+
+  static const String roleCashier = 'cashier';
+  static const String roleManager = 'manager';
+
+  bool get isVoided => voidedAt != null;
+}
diff --git a/lib/features/finance/models/expense.g.dart b/lib/features/finance/models/expense.g.dart
new file mode 100644
index 0000000..8561d45
--- /dev/null
+++ b/lib/features/finance/models/expense.g.dart
@@ -0,0 +1,83 @@
+// GENERATED CODE - DO NOT MODIFY BY HAND
+
+part of 'expense.dart';
+
+// **************************************************************************
+// TypeAdapterGenerator
+// **************************************************************************
+
+class ExpenseAdapter extends TypeAdapter<Expense> {
+  @override
+  final int typeId = 14;
+
+  @override
+  Expense read(BinaryReader reader) {
+    final numOfFields = reader.readByte();
+    final fields = <int, dynamic>{
+      for (int i = 0; i < numOfFields; i++) reader.readByte(): reader.read(),
+    };
+    return Expense(
+      id: fields[0] as String,
+      date: fields[1] as DateTime,
+      createdAt: fields[2] as DateTime,
+      amount: fields[3] as double,
+      categoryId: fields[4] as String,
+      categoryType: fields[5] as String,
+      paidFrom: fields[6] as String,
+      description: fields[7] as String,
+      vendor: fields[8] as String?,
+      inputVat: fields[9] as double?,
+      whtAmount: fields[10] as double?,
+      createdByRole: fields[11] as String,
+      voidedAt: fields[12] as DateTime?,
+      voidReason: fields[13] as String?,
+      voidedBy: fields[14] as String?,
+    );
+  }
+
+  @override
+  void write(BinaryWriter writer, Expense obj) {
+    writer
+      ..writeByte(15)
+      ..writeByte(0)
+      ..write(obj.id)
+      ..writeByte(1)
+      ..write(obj.date)
+      ..writeByte(2)
+      ..write(obj.createdAt)
+      ..writeByte(3)
+      ..write(obj.amount)
+      ..writeByte(4)
+      ..write(obj.categoryId)
+      ..writeByte(5)
+      ..write(obj.categoryType)
+      ..writeByte(6)
+      ..write(obj.paidFrom)
+      ..writeByte(7)
+      ..write(obj.description)
+      ..writeByte(8)
+      ..write(obj.vendor)
+      ..writeByte(9)
+      ..write(obj.inputVat)
+      ..writeByte(10)
+      ..write(obj.whtAmount)
+      ..writeByte(11)
+      ..write(obj.createdByRole)
+      ..writeByte(12)
+      ..write(obj.voidedAt)
+      ..writeByte(13)
+      ..write(obj.voidReason)
+      ..writeByte(14)
+      ..write(obj.voidedBy);
+  }
+
+  @override
+  int get hashCode => typeId.hashCode;
+
+  @override
+  bool operator ==(Object other) =>
+      identical(this, other) ||
+      other is ExpenseAdapter &&
+          runtimeType == other.runtimeType &&
+          typeId == other.typeId;
+}
diff --git a/lib/features/finance/screens/cashier_expense_page.dart b/lib/features/finance/screens/cashier_expense_page.dart
new file mode 100644
index 0000000..0cd4628
--- /dev/null
+++ b/lib/features/finance/screens/cashier_expense_page.dart
@@ -0,0 +1,97 @@
+import 'package:flutter/material.dart';
+import 'package:hive_flutter/hive_flutter.dart';
+import 'package:intl/intl.dart';
+import 'package:provider/provider.dart';
+
+import '../../../state/app_state_controller.dart';
+import '../expense_repository.dart';
+import '../finance_repository.dart';
+import '../models/expense.dart';
+import '../widgets/expense_form.dart';
+
+/// The only cashier-facing finance screen. A simple entry form plus a
+/// read-only list of the expenses entered today. No totals, no edit, no void,
+/// no reports.
+class CashierExpensePage extends StatelessWidget {
+  const CashierExpensePage({super.key});
+
+  @override
+  Widget build(BuildContext context) {
+    final repo = ExpenseRepository.instance;
+    final box = repo.box;
+    final allowed = FinanceRepository.instance.settings.allowCashierExpenses;
+
+    Widget body;
+    if (!repo.isReady || box == null) {
+      body = const Center(
+        child: Padding(
+          padding: EdgeInsets.all(24),
+          child: Text('Expenses are not available on this device.'),
+        ),
+      );
+    } else if (!allowed) {
+      body = const Center(
+        child: Padding(
+          padding: EdgeInsets.all(24),
+          child: Text('Logging expenses is switched off.'),
+        ),
+      );
+    } else {
+      final symbol = context.read<AppStateController>().settings.currencySymbol;
+      body = ListView(
+        padding: const EdgeInsets.all(16),
+        children: [
+          const ExpenseForm(role: Expense.roleCashier),
+          const SizedBox(height: 24),
+          Text('Entered today', style: Theme.of(context).textTheme.titleMedium),
+          const SizedBox(height: 8),
+          ValueListenableBuilder<Box<Expense>>(
+            valueListenable: box.listenable(),
+            builder: (context, _, child) {
+              final today = repo.enteredTodayByCashier();
+              if (today.isEmpty) {
+                return const Card(
+                    child: ListTile(title: Text('Nothing entered yet today')));
+              }
+              final money = NumberFormat('#,##0.00');
+              return Card(
+                child: Column(
+                  children: [
+                    for (final e in today)
+                      ListTile(
+                        title: Text(
+                          repo.categoryName(e.categoryId),
+                          style: e.isVoided
+                              ? const TextStyle(
+                                  decoration: TextDecoration.lineThrough)
+                              : null,
+                        ),
+                        subtitle: Text([
+                          DateFormat('HH:mm').format(e.createdAt),
+                          e.paidFrom,
+                          if (e.description.isNotEmpty) e.description,
+                          if (e.isVoided) 'Voided',
+                        ].join(' · ')),
+                        trailing: Text(
+                          '$symbol${money.format(e.amount)}',
+                          style: e.isVoided
+                              ? const TextStyle(
+                                  decoration: TextDecoration.lineThrough)
+                              : null,
+                        ),
+                      ),
+                  ],
+                ),
+              );
+            },
+          ),
+        ],
+      );
+    }
+
+    return Scaffold(
+      appBar: AppBar(title: const Text('Log Expense')),
+      body: body,
+    );
+  }
+}
diff --git a/lib/features/finance/screens/expenses_page.dart b/lib/features/finance/screens/expenses_page.dart
